{
    
    "files": {
        "commonPath": "./files/",
        "tempPath": "./files-tmp/"
    },
    "database": {
        "production": "./core/db/production.db",
        "migration": "./core/db/migration.db"
    },
    "permissions": {
        "canUploadFiles": 1,
        "canUseBasicCommands": 2,
        "canUseHiddenCommands": 4,
        "canUseTestCommands": 8,
        "canUseAdminCommands": 16
    },
    "commands": {
        "path": "./commands",
        "list": {
            "ping": {
                "permissions": [2],
                "description": "отправляет ПОНГ в ответ на вызов команды",
                "arguments": {
                    "msg": {
                        "isRequired": false,
                        "description": "Сообщение, которое необходимо вернуть.",
                        "type": "string",
                        "default": null
                    }
                }
            },
            "flip": {
                "permissions": [2],
                "description": "подбрасывает монетку",
                "arguments": {
                }
            },
            "play": {
                "permissions": [2],
                "description": "начать игровую сессию",
                "arguments": {
                    "game": {
                        "isRequired": true,
                        "description": "игра",
                        "type": "select",
                        "default": null,
                        "table": "games"
                    }
                }
            },
            "sql": {
                "permissions": [8],
                "description": "дебаг sql запросов",
                "arguments": {
                    "statement": {
                        "isRequired": true,
                        "description": "запрос",
                        "type": "string",
                        "default": null
                    }
                }
            }
        }
    }
}